#!/usr/bin/env bash
# Claude Code Stop hook: continues approved work from the checkout's work
# record instead of letting the coordinator stop prematurely.

set -euo pipefail

# shellcheck source=renewal-request.sh
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/renewal-request.sh"
# shellcheck source=context-size.sh
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/context-size.sh"

# Nudges allowed while the record stays unchanged within one run of
# hook-driven continuations; beyond this the stop is let through.
MAX_NUDGES=3
# Tokens of main-conversation context at which the session hands off for
# renewal. A setting because the context window, and with it the point where
# Claude compacts on its own, differs by model: the handoff turn must fit
# below that point.
RENEWAL_TOKENS=${CLAUDE_RENEWAL_TOKENS:-175000}
# Tokens kept below the recorded context window when that caps the threshold.
# Claude Code compacts a 200k window on its own near 167k, and was seen to at
# ~144k; 60k hands off at 140k there and leaves 1M windows at the setting.
COMPACTION_RESERVE=60000

input=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$input")
cwd=${cwd:-$PWD}
# Said with whatever this stop decides, so renewal is never silently off.
warning=""

allow_stop() {
  [[ -z "$warning" ]] || jq -n --arg w "$warning" '{systemMessage: $w}'
  exit 0
}

# An unexpected work-record failure must not turn continuation off unnoticed.
cannot_consult() {
  warning="${warning:+$warning }Could not consult the work record for $cwd, so this stop was allowed: $1"
  allow_stop
}

# Sets consulted to work-record's output for this checkout, or allows the stop
# with the cause.
consult() {
  local status=0
  consulted=$(work-record --cwd "$cwd" "$@" 2>&1) || status=$?
  ((status == 0)) || cannot_consult "\`work-record $1\` exited $status: $consulted"
}

# Prints the hook's JSON from stdin with the warning added. It runs in a
# pipeline, so the caller exits after it.
respond() {
  jq --arg w "$warning" 'if $w == "" then . else .systemMessage = ([.systemMessage // empty, $w] | join(" ")) end'
}

# Tokens in the main conversation's context, then the context window when
# known: the size and window the status line recorded for this session, else
# the latest main-chain usage in the transcript since the last compaction.
# The record's age is not checked: the status line rewrites it after every
# assistant message and drops it when usage is unknown, as after compaction.
# The transcript is read, never recorded; fails with 1 when it cannot be
# read, and with 2 when its tail holds neither usage nor a compaction.
context_tokens() {
  local transcript tokens window="" file
  if file=$(context_size_file "$(jq -r '.session_id // empty' <<<"$input")") &&
    { read -r tokens && { read -r window || true; }; } 2>/dev/null <"$file" && [[ "$tokens" =~ ^[0-9]+$ ]]; then
    echo "$tokens $window"
    return 0
  fi
  transcript=$(jq -r '.transcript_path // empty' <<<"$input")
  [[ -f "$transcript" && -r "$transcript" ]] || return 1
  tokens=$(tail -n 500 "$transcript" | jq -Rn '
    def usage: .message | if type == "object" then .usage else null end;
    reduce (inputs | fromjson? | objects) as $e ("none";
      if $e.compactMetadata != null or $e.isCompactSummary == true then null
      elif $e.isSidechain != true and ($e | usage | type) == "object" then ($e | usage)
      else . end)
    | if . == "none" then empty
      elif . == null then 0
      else [.input_tokens, .cache_read_input_tokens, .cache_creation_input_tokens, .output_tokens] | map(. // 0) | add
      end' 2>/dev/null) || return 1
  [[ -n "$tokens" ]] || return 2
  echo "$tokens"
}

# Asks the helper outside the sandbox, which owns this pane's Herdr
# traffic, to renew once the turn settles. Written once per handoff so a
# renewal in flight is not reset; sets requested when it writes.
requested=false
request_renewal() {
  local state handoff tmp
  consult path
  state=$(renewal_file "$consulted")
  consult read
  handoff=$(jq -r '.artifacts.handoff.record' <<<"$consulted")
  [[ "$(jq -r '.handoff // empty' "$state" 2>/dev/null)" != "$handoff" ]] || return 0
  tmp=$(mktemp "$state.XXXXXX")
  renewal_request "$handoff" "$(jq -r '.session_id // empty' <<<"$input")" "$HERDR_PANE_ID" >"$tmp"
  mv -f "$tmp" "$state"
  requested=true
}

# A running background agent wakes the session when it finishes; nudging
# now could dispatch duplicate work.
worker_running=false
if jq -e '[.background_tasks[]? | select(.status == "running" and (has("agent_type") or (.type | tostring | test("agent"))))] | length > 0' \
  <<<"$input" >/dev/null; then
  worker_running=true
fi

status=0
outcome=$(work-record --cwd "$cwd" check 2>&1) || status=$?
case "$status" in
0) ;;
3) allow_stop ;;
4)
  jq -n --arg m "Work record for $cwd is inconsistent; run \`work-record --cwd $cwd read\` and reconcile it." \
    '{systemMessage: $m}'
  allow_stop
  ;;
*) cannot_consult "\`work-record check\` exited $status: $outcome" ;;
esac
[[ "$outcome" == continue ]] || allow_stop

context=$(context_tokens) || {
  case $? in
  2) cause="the last 500 lines of the session transcript hold no main-conversation usage" ;;
  *) cause="the session transcript could not be read" ;;
  esac
  context=0
  warning="Context size is unknown: $cause, so context renewal cannot start on its own. Hand off with mojo-handoff and renew by hand when the context is large."
}
read -r tokens window <<<"$context"
limit=$RENEWAL_TOKENS
if [[ "$window" =~ ^[0-9]+$ ]] && ((window > COMPACTION_RESERVE && window - COMPACTION_RESERVE < limit)); then
  limit=$((window - COMPACTION_RESERVE))
fi

consult path
record_path=$consulted

# Progress is any change to the record; a stop that was not itself caused by
# a hook continuation (a human prompt, a background wake) starts a new count.
# A renewal pause holds whatever caused the stop.
state="$(dirname "$record_path")/stop-nudges"
active=$(jq -r '.stop_hook_active // false' <<<"$input")
last_fingerprint="" last_count=0 last_kind=""
if [[ -f "$state" ]]; then
  read -r last_fingerprint last_count last_kind _ <"$state" || true
fi
if [[ "$active" != true && "$last_kind" != paused ]]; then
  last_fingerprint="" last_count=0 last_kind=""
fi

# A current handoff or context below the threshold ends a renewal pause.
end_pause() {
  [[ "$last_kind" != paused ]] || : >"$state"
}

# Continuation and renewal are decided here, once per stop, so they never
# issue competing commands. A current handoff means the coordinator handed
# off and waits for renewal; any later record write makes it stale and
# nudging resumes.
if [[ "$(work-record --cwd "$cwd" handoff 2>/dev/null)" == current ]]; then
  end_pause
  if [[ "${HERDR_ENV:-}" == 1 && -n "${HERDR_PANE_ID:-}" ]]; then
    request_renewal
    $requested || allow_stop
    # The helper may not be running; the user must not wait in silence.
    jq -n '{systemMessage: "Context renewal requested: Herdr compacts this pane, then submits /mojo-resume. If nothing happens, renew by hand: /compact, then /mojo-resume."}' |
      respond
    exit 0
  fi
  jq -n '{systemMessage: "A reasoned handoff is current, but this session is not in a Herdr pane to renew it. Renew by hand: /compact, then /mojo-resume."}' |
    respond
  exit 0
fi

consult read
record=$consulted
fingerprint=$(git hash-object --stdin <<<"$record")

save_state() {
  local tmp
  tmp=$(mktemp "${state}.XXXXXX")
  printf '%s %s %s\n' "$fingerprint" "$1" "$2" >"$tmp"
  mv -f "$tmp" "$state"
}

if ((tokens >= limit)); then
  # The request was made and the agent stopped without a current handoff.
  if [[ "$last_kind" == handoff || "$last_kind" == paused ]]; then
    save_state 0 paused
    jq -n --arg m "Context renewal paused: a reasoned handoff was requested at $tokens tokens but is not current ($(work-record --cwd "$cwd" handoff)). Write one with mojo-handoff, or renew by hand." \
      '{systemMessage: $m}' | respond
    exit 0
  fi
  save_state 0 handoff
  jq -n --argjson tokens "$tokens" --argjson limit "$limit" '{
    decision: "block",
    reason: "Context holds \($tokens) tokens (renewal threshold \($limit)); hand off for renewal. Finish the step you are on without starting new work or dispatching workers beyond what that step needs, record progress in the work record, then invoke the mojo-handoff skill, naming every background worker still running, and stop: this pane is compacted and resumed from the handoff. Do not wait for running background workers first; their reports arrive in the renewed context."
  }' | respond
  exit 0
fi

end_pause
$worker_running && allow_stop

count=1
if [[ "${last_fingerprint:-}" == "$fingerprint" && "${last_kind:-continue}" == continue ]]; then
  count=$((${last_count:-0} + 1))
fi
save_state "$count" continue

if ((count > MAX_NUDGES)); then
  jq -n --arg m "Stopped after $MAX_NUDGES continuation nudges without work-record progress ($record_path)." \
    '{systemMessage: $m}' | respond
  exit 0
fi

jq -n --argjson r "$record" --arg path "$record_path" '{
  decision: "block",
  reason: ("Approved work in this checkout is unfinished. Continue from the work record (\($path)): next action: \($r.next_action)"
    + (if $r.current_ticket then " (current ticket \($r.current_ticket))" else "" end)
    + ". If a worker you dispatched is still running or its report is unreconciled, wait for or reconcile it; do not dispatch another. If a human decision is needed, record a human_gate and stop.")
}' | respond
