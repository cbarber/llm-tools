#!/usr/bin/env bash
# Claude Code SessionStart hook (compact): points a compacted session at the
# mojo-resume entry when its checkout has unfinished coordinated work.

set -euo pipefail

input=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$input")
cwd=${cwd:-$PWD}

[[ "$(jq -r '.source // "compact"' <<<"$input")" == compact ]] || exit 0

status=0
outcome=$(work-record --cwd "$cwd" check 2>/dev/null) || status=$?
case "$status" in
0) [[ "$outcome" != complete ]] || exit 0 ;;
4) outcome=inconsistent ;;
*) exit 0 ;;
esac

# Only a pointer: the skill itself loads the record, handoff, and
# workflow skills when invoked.
jq -n --arg path "$(work-record --cwd "$cwd" path)" --arg outcome "$outcome" '{
  hookSpecificOutput: {
    hookEventName: "SessionStart",
    additionalContext: ("Context was just compacted while this checkout has coordinated work (work record \($path), continuation: \($outcome)). Before anything else, invoke the mojo-resume skill, unless it is already being invoked, and act only on what it reloads; do not continue from the compaction summary. A pending human gate stays pending.")
  }
}'
